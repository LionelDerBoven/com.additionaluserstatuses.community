{
  "extends": "athom/homey-app",
  "ignorePatterns": ["tools/**"],
  "overrides": [
    {
      "files": [
        "settings/**/*.js"
      ],
      "env": {
        "browser": true
      },
      "globals": {
        "Homey": "readonly"
      },
      "rules": {
        "homey-app/global-timers": "off",
        "no-unused-vars": "off",
        "@typescript-eslint/no-unused-vars": "off",
        "no-use-before-define": "off"
      }
    },
    {
      "files": [
        "test/**/*.js"
      ],
      "rules": {
        "homey-app/global-timers": "off"
      }
    }
  ]
}