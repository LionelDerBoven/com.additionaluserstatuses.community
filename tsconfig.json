{
  "compilerOptions": {
    "target": "es2022",
    "module": "commonjs",
    "moduleResolution": "node",
    "allowJs": true,
    "checkJs": false,
    "noEmit": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "skipLibCheck": true
  },
  "include": ["*.js", "lib/**/*.js", "drivers/**/*.js", "settings/**/*.js", "test/**/*.js"],
  "exclude": ["node_modules", ".homeybuild"]
}
