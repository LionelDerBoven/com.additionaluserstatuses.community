{
  "id": "com.additionaluserstatuses.community",
  "version": "2.3.3",
  "compatibility": ">=12.4.0",
  "sdk": 3,
  "runtime": "nodejs",
  "platforms": [
    "local"
  ],
  "name": {
    "en": "Additional User Statuses",
    "nl": "Extra gebruikersstatussen",
    "fr": "Statuts d'utilisateur supplémentaires"
  },
  "description": {
    "en": "Presence and sleep cards for the whole household, plus statuses of your own",
    "nl": "Aanwezigheids- en slaapkaarten voor het hele huishouden, plus eigen statussen",
    "fr": "Cartes de présence et de sommeil pour tout le foyer, et vos propres statuts"
  },
  "brandColor": "#3D5A96",
  "category": [
    "tools"
  ],
  "permissions": [
    "homey:manager:api"
  ],
  "images": {
    "small": "assets/images/small.jpg",
    "large": "assets/images/large.jpg",
    "xlarge": "assets/images/xlarge.jpg"
  },
  "author": {
    "name": "LDB Technology",
    "email": "homey@ldbtechnology.be"
  },
  "support": "mailto:support@ldbtechnology.be",
  "source": "https://github.com/LionelDerBoven/com.additionaluserstatuses.community",
  "bugs": {
    "url": "https://github.com/LionelDerBoven/com.additionaluserstatuses.community/issues"
  },
  "api": {
    "getUsers": {
      "method": "get",
      "path": "/users"
    },
    "setVacation": {
      "method": "post",
      "path": "/vacation"
    },
    "getLog": {
      "method": "get",
      "path": "/log"
    },
    "clearLog": {
      "method": "post",
      "path": "/log/clear"
    },
    "getStatuses": {
      "method": "get",
      "path": "/statuses"
    },
    "setStatus": {
      "method": "post",
      "path": "/status"
    },
    "saveStatuses": {
      "method": "post",
      "path": "/statuses"
    }
  }
}
