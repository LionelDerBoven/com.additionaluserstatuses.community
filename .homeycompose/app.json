{
  "id": "com.additionaluserstatuses.community",
  "version": "1.0.0",
  "compatibility": ">=12.4.0",
  "sdk": 3,
  "runtime": "nodejs",
  "platforms": [
    "local"
  ],
  "name": {
    "en": "Additional User Statuses"
  },
  "description": {
    "en": "Adds the household-wide presence and sleep condition cards Homey does not have: 'Everyone is at home' and 'Everyone is asleep'. The cards read your Homey users live, so adding or removing a housemate never means editing a Flow. Unofficial community app."
  },
  "brandColor": "#3D5A96",
  "category": [
    "tools"
  ],
  "permissions": [
    "homey:manager:api"
  ],
  "images": {
    "small": "assets/images/small.png",
    "large": "assets/images/large.png",
    "xlarge": "assets/images/xlarge.png"
  },
  "author": {
    "name": "LDB Technology",
    "email": "homey@ldbtechnology.be"
  },
  "api": {
    "getUsers": {
      "method": "get",
      "path": "/users"
    }
  }
}
