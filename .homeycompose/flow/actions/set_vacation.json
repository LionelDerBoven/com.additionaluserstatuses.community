{
  "id": "set_vacation",
  "title": {
    "en": "Set user status to vacation"
  },
  "titleFormatted": {
    "en": "Set [[user]] status to [[state]]"
  },
  "hint": {
    "en": "Marks a user as on vacation, or clears it. While a user is on vacation they are left out of the 'everyone' cards, so those keep working for whoever is still around."
  },
  "args": [
    {
      "name": "user",
      "type": "autocomplete",
      "title": {
        "en": "User"
      },
      "placeholder": {
        "en": "Choose a user…"
      }
    },
    {
      "name": "state",
      "type": "dropdown",
      "title": {
        "en": "Status"
      },
      "values": [
        {
          "id": "on",
          "title": {
            "en": "on vacation"
          }
        },
        {
          "id": "off",
          "title": {
            "en": "returned"
          }
        }
      ]
    }
  ]
}
