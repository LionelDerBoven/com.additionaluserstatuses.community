{
  "id": "count_users",
  "title": {
    "en": "The number of users … !{{is|is not}} … …",
    "nl": "Het aantal gebruikers … !{{is|is niet}} … …",
    "fr": "Le nombre d'utilisateurs … !{{est|n'est pas}} … …"
  },
  "titleFormatted": {
    "en": "The number of users [[state]] !{{is|is not}} [[operator]] [[count]]",
    "nl": "Het aantal gebruikers [[state]] !{{is|is niet}} [[operator]] [[count]]",
    "fr": "Le nombre d'utilisateurs [[state]] !{{est|n'est pas}} [[operator]] [[count]]"
  },
  "hint": {
    "en": "Counts the chosen group of users, ignoring users on vacation, unticked in the settings or disabled in Homey.",
    "nl": "Telt de gekozen groep gebruikers, zonder wie op vakantie is, in de instellingen is uitgevinkt of in Homey is uitgeschakeld.",
    "fr": "Compte le groupe d'utilisateurs choisi, sans ceux en vacances, décochés dans les réglages ou désactivés dans Homey."
  },
  "args": [
    {
