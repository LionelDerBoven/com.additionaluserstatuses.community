      "type": "dropdown",
      "title": {
        "en": "Comparison",
        "nl": "Vergelijking",
        "fr": "Comparaison"
      },
      "values": [
        {
          "id": "min",
          "title": {
            "en": "at least",
            "nl": "minstens",
            "fr": "supérieur ou égal à"
          }
        },
        {
          "id": "exact",
          "title": {
            "en": "exactly",
            "nl": "precies",
            "fr": "égal à"
          }
        },
        {
          "id": "max",
          "title": {
            "en": "at most",
            "nl": "hoogstens",
            "fr": "inférieur ou égal à"
          }
        }
      ]
    },
    {
      "name": "count",
      "type": "number",
      "min": 0,
      "step": 1,
      "title": {
        "en": "Number",
        "nl": "Aantal",
        "fr": "Nombre"
